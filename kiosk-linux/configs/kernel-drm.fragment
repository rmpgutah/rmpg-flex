# kiosk-linux/configs/kernel-drm.fragment
# Enables DRM/KMS core support plus the virtio-gpu driver, for a real graphics
# pipeline under QEMU's paravirtualized GPU device. Layered on top of the existing
# in-tree "x86_64" kernel defconfig (BR2_LINUX_KERNEL_DEFCONFIG in
# qemu_x86_64_kiosk_defconfig) via Buildroot's kernel config-fragment mechanism
# (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES, verified against the real Buildroot
# 2024.02.9 checkout: package/../linux/Config.in:194 defines the symbol, and
# linux/linux.mk:339 merges LINUX_KCONFIG_FRAGMENT_FILES into the kernel .config
# after the base defconfig is applied via scripts/kconfig/merge_config.sh) —
# this keeps sub-project 1's kernel-defconfig choice untouched rather than
# requiring a full custom kernel .config file.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y

# Added in sub-project 3 (browser). Without this, nothing ever commits an
# initial mode on the virtio-gpu output at boot, so the encoder's crtc_id
# stays unset. Cog's DRM platform (platform/drm/cog-platform-drm.c,
# find_crtc_for_encoder()) only reuses an ALREADY-ACTIVE encoder->crtc
# pairing — it has no fallback path to allocate a fresh, unbound one — so
# without a boot-time console already having set a mode, Cog fails with
# "no crtc for encoder found!" even though the DRM device itself works fine
# (confirmed: modetest -s, sub-project 2's own proof mechanism, can commit a
# mode manually just fine). Enabling DRM's own fbdev emulation + a
# framebuffer console makes the kernel commit an initial mode automatically
# at boot, the same way it would on real hardware whose firmware/bootloader
# already left a mode active — satisfying what Cog assumes.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
