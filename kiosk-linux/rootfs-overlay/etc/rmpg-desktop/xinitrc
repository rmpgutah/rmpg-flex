#!/bin/sh
# /etc/rmpg-desktop/xinitrc — the RMPG Flex Desktop session.
#
# Started by S99kiosk-desktop via `xinit`. Everything here runs INSIDE the X
# session; the last command must block, because when it exits X shuts down.
#
# Startup order matters:
#   1. Window manager first — anything mapped before a WM is running gets no
#      title bar and no decorations until the WM adopts it, which looks broken
#      for the first second of every boot.
#   2. Desktop layer (wallpaper + icons) second, so it sits behind everything.
#   3. Taskbar third, so it can already see any windows that exist.
#   4. Auto-started apps last.

export XDG_RUNTIME_DIR=/tmp/xdg-runtime
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"
export XDG_CONFIG_HOME=/etc/rmpg-desktop/config
export XDG_DATA_DIRS=/usr/share
export GTK_THEME=Adwaita:dark

# Blank the root window to the RMPG navy before anything else paints, so the
# session never flashes the default X stipple pattern.
xsetroot -solid "#0c1a2b" 2>/dev/null

# 1. Window manager.
openbox &
OPENBOX_PID=$!

# Give Openbox a moment to claim the WM selection before mapping any window.
i=0
while [ "$i" -lt 50 ]; do
  xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id" && break
  i=$((i + 1))
  sleep 0.1
done

# 2. Desktop layer: pcmanfm --desktop draws the wallpaper and desktop icons.
pcmanfm --desktop --profile=rmpg >/tmp/pcmanfm-desktop.log 2>&1 &

# 3. Taskbar / Start menu.
rmpg-shell >/tmp/rmpg-shell.log 2>&1 &

# 4. RMPG Flex opens automatically — this is a dispatch terminal first and a
#    general workstation second, so the console should already be up.
#    --app mode gives a chromeless window (no tabs/address bar) so it reads as
#    a native application rather than a browser tab, while still being a real
#    resizable window the user can minimize like any other.
if [ "${RMPG_DESKTOP_AUTOSTART_FLEX:-1}" = "1" ]; then
  # rmpg-browser, NOT midori: midori was dropped from the build because it
  # depends on libpeas, which forces gobject-introspection on globally and
  # broke the build outright (pango could not generate its .gir because
  # harfbuzz had already been built for wpewebkit without introspection).
  # This line still said "midori" after that swap — a dead reference to a
  # binary no longer in the image, which fails silently because it is
  # backgrounded, leaving the desktop up with no console window and no error.
  rmpg-browser --app="https://rmpgutah.us" >/tmp/flex-app.log 2>&1 &
fi

echo "KIOSK_LINUX_DESKTOP_SESSION_UP"

# Block on the window manager. If Openbox dies the session is unusable, so
# letting X exit here lets S99kiosk-desktop restart the whole session cleanly
# rather than leaving a bare X server with no way to interact with it.
wait "$OPENBOX_PID"
