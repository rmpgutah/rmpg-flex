{
  "name": "rmpg-flex-cloudflare",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "echo 'Wrangler handles bundling at deploy time'",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "sync:downloads": "bash scripts/sync-downloads-r2.sh",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run -c vitest.workers.config.mts",
    "migrate:local": "wrangler d1 execute rmpg-flex --local --file migrations/baseline/schema.sql && wrangler d1 migrations apply rmpg-flex --local",
    "migrate:prod": "wrangler d1 migrations apply rmpg-flex --remote",
    "baseline:build": "node scripts/build-baseline.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/puppeteer": "^1.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@mapbox/vector-tile": "^2.0.5",
    "@noble/post-quantum": "^0.6.1",
    "@simplewebauthn/server": "^13.3.2",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "mp4box": "^2.4.1",
    "pbf": "^4.0.2",
    "pdf-lib": "^1.17.1",
    "pmtiles": "^4.4.1",
    "unpdf": "^1.8.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/node": "^26.1.2",
    "@types/uuid": "^10.0.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260625.1": true
  }
}
