{
  "name": "rmpg-flex-cloudflare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "sync:downloads": "bash scripts/sync-downloads-r2.sh",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply rmpg-flex --local",
    "migrate:prod": "wrangler d1 migrations apply rmpg-flex --remote"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.6",
    "bcryptjs": "^3.0.3",
    "hono": "^4.12.21",
    "jose": "^6.2.3",
    "pmtiles": "^4.4.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@cloudflare/workers-types": "^4.20260601.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.1",
    "@types/uuid": "^10.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.96.0"
  }
}
