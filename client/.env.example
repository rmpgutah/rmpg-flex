# RMPG Flex Client — Environment Variables
#
# Copy this to .env (local dev) or set these in the Cloudflare Pages dashboard
# (Settings → Environment variables) for production / preview builds.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# REQUIRED — Mapbox GL JS access token (https://account.mapbox.com/access-tokens/)
# Without this the map page will render a placeholder.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# OPTIONAL — Override the API base URL.
# Default: '' (same-origin — the SPA and the Worker are served from the same
# Cloudflare Pages project in prod, so an empty string is correct for the
# deployed app.)  Set this for local dev only if you run the Worker separately.
#VITE_API_BASE_URL=http://localhost:8787
