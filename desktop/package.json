{
  "name": "rmpg-flex-desktop",
  "version": "5.9.0",
  "description": "RMPG Flex CAD/RMS — Desktop Application",
  "author": "Rocky Mountain Protective Group",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron . --dev",
    "// test": "better-sqlite3 must be built for Node's ABI (not Electron's) for the DB-backed tests to load — postinstall/`npm run rebuild` build it for ELECTRON's ABI instead, so a fresh `npm install && npm test` fails most tests with a NODE_MODULE_VERSION mismatch. Before running tests: `npm rebuild better-sqlite3`. After running tests (whether they pass or fail): `npm run rebuild` to restore the Electron-ABI build, or `npm start`/the packaged app will crash on native module load. This is NOT automated via pretest/posttest — npm does not run posttest when the test script exits non-zero, so an automated posttest would silently skip the Electron-ABI restore on a failing test run and leave the app broken with no obvious signal. Do the rebuild dance by hand.",
    "test": "node --test '__tests__/**/*.js' 'security/__tests__/**/*.js'",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac -c.mac.identity=null",
    "build:all": "electron-builder --mac --win",
    "postinstall": "electron-rebuild -f -w serialport,better-sqlite3 || echo '[postinstall] electron-rebuild skipped'",
    "rebuild": "electron-rebuild -f -w serialport,better-sqlite3"
  },
  "build": {
    "appId": "com.rmpg.flex",
    "productName": "RMPG Flex",
    "copyright": "Copyright (c) Rocky Mountain Protective Group, LLC",
    "afterPack": "./scripts/afterPack.cjs",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "generic",
      "url": "https://api.rmpgutah.us/updates/"
    },
    "files": [
      "main.js",
      "preload.js",
      "kioskShell.js",
      "kioskEscapePreload.js",
      "kioskEscape.html",
      "splashPreload.js",
      "splash.html",
      "updater.js",
      "localDb.js",
      "connectivityMonitor.js",
      "pinManager.js",
      "offlineRouter.js",
      "syncManager.js",
      "internalGps.js",
      "systemInfo.js",
      "hardwareFz55.js",
      "fileOps.js",
      "deviceInfo.js",
      "windowManager.js",
      "crashRecovery.js",
      "originalCatalog.json",
      "security",
      "splash.html",
      "splashPreload.js",
      "assets/login-bg.jpg",
      "assets/logo.png",
      "**/node_modules/node-hid/**/*",
      "**/node_modules/usb-detection/**/*",
      "**/node_modules/@vladmandic/**/*",
      "**/node_modules/jsqr/**/*"
    ],
    "extraResources": [
      {
        "from": "../client/public/rmpg-seal.png",
        "to": "icon.png"
      },
      {
        "from": "../client/public/rmpg flex.png",
        "to": "rmpg flex.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/serialport/**/*",
      "**/node_modules/@serialport/**/*",
      "**/node_modules/bindings/**/*",
      "**/node_modules/file-uri-to-path/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "artifactName": "RMPG-Flex-${version}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "../client/public/rmpg-seal.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "backgroundColor": "#000000",
      "title": "RMPG Flex Installer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../client/public/rmpg-seal.ico"
    },
    "nsis": {
      "artifactName": "RMPG-Flex-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../client/public/rmpg-seal.ico",
      "uninstallerIcon": "../client/public/rmpg-seal.ico",
      "installerHeaderIcon": "../client/public/rmpg-seal.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RMPG Flex"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "../client/public/rmpg-seal.png"
    }
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "@vladmandic/face-api": "^1.7.15",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "serialport": "^13.0.0"
  },
  "optionalDependencies": {
    "node-hid": "^3.1.0",
    "usb-detection": "^4.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "lodash": ">=4.18.0",
    "tar": ">=6.2.1"
  }
}
